<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ book_title }}">
<meta property="og:title" content="{{#if chapter_title}}{{ chapter_title }}{{else}}{{ book_title }}{{/if}}">
<meta property="og:description" content="{{ description }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{#if chapter_title}}{{ chapter_title }}{{else}}{{ book_title }}{{/if}}">
<meta name="twitter:description" content="{{ description }}">
