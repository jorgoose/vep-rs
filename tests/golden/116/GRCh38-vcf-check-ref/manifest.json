 "runs": [
  {
   "name": "lookup-ref-default",
   "argv": [
    "-i",
    "{input}",
    "--offline",
    "--json_cache",
    "{cache}",
    "--species",
    "homo_sapiens",
    "--assembly",
    "{assembly}",
    "--buffer_size",
    "5000",
    "--force_overwrite",
    "--no_stats",
    "--quiet",
    "--lookup_ref",
    "--allow_non_variant",
    "--fasta",
    "{corpus}/reference.fa.gz",
    "-o",
    "{out}"
   ],
   "expect": {
    "exit": 0,
    "output": "lookup_ref_default.txt",
    "warnings_file": "lookup_ref_warnings.txt"
   }
  },
  {
   "name": "check-ref-without-fasta",
   "argv": [
    "-i",
    "{input}",
    "--offline",
    "--json_cache",
    "{cache}",
    "--species",
    "homo_sapiens",
    "--assembly",
    "{assembly}",
    "--buffer_size",
    "5000",
    "--force_overwrite",
    "--no_stats",
    "--quiet",
    "--check_ref",
    "-o",
    "{out}"
   ],
   "expect": {
    "exit": 1,
    "stderr_contains": "ERROR: [fasta] Cannot check reference sequences (--check_ref) without a FASTA file (see --fasta)"
   }
  },
  {
   "name": "lookup-ref-without-fasta",
   "argv": [
    "-i",
    "{input}",
    "--offline",
    "--json_cache",
    "{cache}",
    "--species",
    "homo_sapiens",
    "--assembly",
    "{assembly}",
    "--buffer_size",
    "5000",
    "--force_overwrite",
    "--no_stats",
    "--quiet",
    "--lookup_ref",
    "-o",
    "{out}"
   ],
   "expect": {
    "exit": 1,
    "stderr_contains": "ERROR: [fasta] Cannot look up reference sequences (--lookup_ref) without a FASTA file (see --fasta)"
   }
  },
  {
   "name": "use-transcript-ref-default",
   "argv": [
    "-i",
    "{input}",
    "--offline",
    "--json_cache",
    "{cache}",
    "--species",
    "homo_sapiens",
    "--assembly",
    "{assembly}",
    "--buffer_size",
    "5000",
    "--force_overwrite",
    "--no_stats",
    "--quiet",
    "--use_transcript_ref",
    "--allow_non_variant",
    "--fasta",
    "{corpus}/reference.fa.gz",
    "-o",
    "{out}"
   ],
   "expect": {
    "exit": 0,
    "output": "use_transcript_ref_default.txt",
    "warnings_file": "use_transcript_ref_warnings.txt"
   }
  },
  {
   "name": "use-transcript-ref-without-fasta",
   "argv": [
    "-i",
    "{input}",
    "--offline",
    "--json_cache",
    "{cache}",
    "--species",
    "homo_sapiens",
    "--assembly",
    "{assembly}",
    "--buffer_size",
    "5000",
    "--force_overwrite",
    "--no_stats",
    "--quiet",
    "--use_transcript_ref",
    "-o",
    "{out}"
   ],
   "expect": {
    "exit": 1,
    "stderr_contains": "ERROR: [fasta] Cannot use transcript reference sequences (--use_transcript_ref) without a FASTA file (see --fasta); you may wish to use --use_given_ref"
   }
  },
  {
   "name": "check-ref-and-lookup-ref",
   "argv": [
    "{golden}",
    "--lookup_ref",
    "-o",
    "{out}"
   ],
   "expect": {
    "exit": 1,
    "stderr_contains": "ERROR: [cli] Can't use --check_ref and --lookup_ref together"
   }
  },
  {
   "name": "skipped-variants-file",
   "argv": [
    "{golden}",
    "-o",
    "{out}",
    "--skipped_variants_file",
    "{out}.skipped.txt"
   ],
   "expect": {
    "exit": 0,
    "output": "default.txt",
    "skipped_file": "skipped.txt"
   }
  }
